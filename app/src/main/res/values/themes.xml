<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Application Theme -->
    <style name="Base.Theme.ResilientNet"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/button_text</item>

        <item name="colorSecondary">@color/primary_blue</item>
        <item name="colorOnSecondary">@color/button_text</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background_white</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/background_white</item>

        <!-- Material Components -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOutline">@color/divider</item>

    </style>

    <style name="CircleImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style
        name="Theme.ResilientNet"
        parent="Base.Theme.ResilientNet" />

</resources>