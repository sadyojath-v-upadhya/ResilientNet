<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarProfile"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="My Profile"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:menu="@menu/profile_toolbar_menu"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include
                android:id="@+id/profileHeader"
                layout="@layout/layout_profile_header"/>

            <include
                android:id="@+id/personalInformation"
                layout="@layout/layout_personal_information"/>

            <include
                android:id="@+id/emergencyInformation"
                layout="@layout/layout_emergency_information"/>

            <include
                android:id="@+id/account"
                layout="@layout/layout_account"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>