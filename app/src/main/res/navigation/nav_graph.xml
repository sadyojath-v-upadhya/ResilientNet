<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.resilientnet.ui.splash.SplashFragment"
        android:label="Splash">

        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/onboarding1Fragment"/>

        <action
            android:id="@+id/action_splash_to_dashboard"
            app:destination="@id/dashboardFragment"/>

        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"/>

    </fragment>

    <!-- Onboarding 1 -->
    <fragment
        android:id="@+id/onboarding1Fragment"
        android:name="com.resilientnet.ui.onboarding.Onboarding1Fragment"
        android:label="Onboarding 1">

        <action
            android:id="@+id/action_onboarding1_to_onboarding2"
            app:destination="@id/onboarding2Fragment" />

    </fragment>

    <!-- Onboarding 2 -->
    <fragment
        android:id="@+id/onboarding2Fragment"
        android:name="com.resilientnet.ui.onboarding.Onboarding2Fragment"
        android:label="Onboarding 2">

        <action
            android:id="@+id/action_onboarding2_to_onboarding3"
            app:destination="@id/onboarding3Fragment" />

    </fragment>

    <!-- Onboarding 3 -->
    <fragment
        android:id="@+id/onboarding3Fragment"
        android:name="com.resilientnet.ui.onboarding.Onboarding3Fragment"
        android:label="Onboarding 3">

        <action
            android:id="@+id/action_onboarding3_to_login"
            app:destination="@id/loginFragment" />

    </fragment>

    <!-- Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.resilientnet.ui.auth.login.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dashboardFragment" />

    </fragment>

    <!-- Register -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.resilientnet.ui.auth.register.RegisterFragment"
        android:label="Register">

        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment" />

    </fragment>

    <!-- Dashboard -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.resilientnet.ui.dashboard.DashboardFragment"
        android:label="Dashboard">

    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.resilientnet.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment"/>

    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.resilientnet.ui.profile.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile"/>


</navigation>